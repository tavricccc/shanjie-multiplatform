{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shanjie model catalog v2 - design draft",
  "description": "Draft contract. Schema validation does not replace source, dependency, loader or advisory semantic checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "revision", "generated_at", "example_only", "models"],
  "properties": {
    "$schema": { "type": "string", "maxLength": 512 },
    "format": { "const": 2 },
    "revision": { "$ref": "#/$defs/sha256" },
    "generated_at": { "type": "string", "format": "date-time" },
    "example_only": { "type": "boolean" },
    "models": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "capability": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "required_capabilities", "assets", "compatibility", "advisory_revision", "advisories"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "required_capabilities": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "assets": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": { "$ref": "#/$defs/asset" }
        },
        "compatibility": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": { "$ref": "#/$defs/compatibility" }
        },
        "advisory_revision": { "$ref": "#/$defs/sha256" },
        "advisories": {
          "type": "array", "maxItems": 32,
          "items": { "$ref": "#/$defs/advisory" }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "repository", "release", "filename", "format_magic", "size", "sha256", "requires_assets"],
      "properties": {
        "role": { "enum": ["bigram", "classes", "smoothing", "trigram", "semantic", "colloquial", "attribution", "license"] },
        "repository": { "const": "Nanako0129/shanjie" },
        "release": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
        "format_magic": { "type": "string", "pattern": "^[A-Z0-9]{8}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "requires_assets": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "profile_id", "source_commit", "state", "checked_at", "report"],
      "properties": {
        "target": { "enum": ["windows-x64", "windows-x86", "linux-x64"] },
        "profile_id": { "$ref": "#/$defs/id" },
        "source_commit": { "$ref": "#/$defs/commit" },
        "state": { "enum": ["usable", "unsupported", "invalid", "unverified"] },
        "checked_at": { "type": "string", "format": "date-time" },
        "report": { "type": "string", "pattern": "^reports/[a-z0-9-]{1,100}\\.json$" },
        "reason": { "type": "string", "maxLength": 1000 }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "body", "measurements"],
      "properties": {
        "code": { "$ref": "#/$defs/capability" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "measurements": {
          "type": "array", "maxItems": 64,
          "items": { "$ref": "#/$defs/measurement" }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "unit", "dataset_id", "dataset_sha256", "configuration_sha256", "sample_count", "baseline_model_id", "baseline", "candidate", "measured_at", "context"],
      "properties": {
        "metric": { "$ref": "#/$defs/capability" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "dataset_id": { "$ref": "#/$defs/id" },
        "dataset_sha256": { "$ref": "#/$defs/sha256" },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "sample_count": { "type": "integer", "minimum": 1 },
        "baseline_model_id": { "$ref": "#/$defs/id" },
        "baseline": { "type": "number", "minimum": 0 },
        "candidate": { "type": "number", "minimum": 0 },
        "measured_at": { "type": "string", "format": "date-time" },
        "context": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
