<Window x:Class="Shanjie_UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="善解設定">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="善解設定" />
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="208" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="Navigate">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="一般" Icon="Home" Tag="general"/>
                <NavigationViewItem Content="按鍵" Icon="Keyboard" Tag="keys"/>
                <NavigationViewItem Content="選字" Icon="Bullets" Tag="candidates"/>
                <NavigationViewItem Content="詞庫與學習" Icon="Library" Tag="dictionary"/>
                <NavigationViewItem Content="關於與相容性" Icon="Help" Tag="about"/>
            </NavigationView.MenuItems>
            <ScrollViewer>
                <StackPanel Padding="20,16,20,20" Spacing="12" MaxWidth="800" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="General" Spacing="12">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="一般" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <ComboBox Header="操作 profile" x:Name="Preset" HorizontalAlignment="Stretch" SelectionChanged="LoadPreset" SelectedIndex="0">
                            <ComboBoxItem Content="目前個人設定"/><ComboBoxItem Content="載入 Windows 微軟注音預設"/><ComboBoxItem Content="載入善解上游預設"/>
                        </ComboBox>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="預設只載入草稿，你可以調整後再儲存。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="預設輸入模式" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="預設輸入模式" OnContent="中文" OffContent="英文" IsOn="{x:Bind Vm.InitialChinese, Mode=TwoWay}"/></Grid>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="預設字元寬度" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="預設字元寬度" OnContent="全形" OffContent="半形" IsOn="{x:Bind Vm.InitialFullWidth, Mode=TwoWay}"/></Grid>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="Caps Lock 輸入英文" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="Caps Lock 輸入英文" IsOn="{x:Bind Vm.CapsLockEnglish, Mode=TwoWay}"/></Grid>
                        <ComboBox Header="鍵盤配置" SelectedIndex="{x:Bind Vm.Keyboard, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="跟隨 Windows 標準／倚天 profile"/><ComboBoxItem Content="標準注音"/><ComboBoxItem Content="倚天注音"/><ComboBoxItem Content="漢語拼音"/><ComboBoxItem Content="臺灣拼音（通用拼音）"/></ComboBox>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="無法轉換的注音／拼音序列輸出英數" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="無法轉換的注音／拼音序列輸出英數" IsOn="{x:Bind Vm.Alphanumeric, Mode=TwoWay}"/></Grid>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="Esc 清除未提交的組字" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="Esc 清除未提交的組字" IsOn="{x:Bind Vm.EscapeClears, Mode=TwoWay}"/></Grid>
                        <ComboBox Header="詞句偏好" SelectedIndex="{x:Bind Vm.Ranking, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="聊天"/><ComboBoxItem Content="正式"/></ComboBox>
                        <ComboBox x:Name="ModelSelector" Header="語言模型" SelectedIndex="{x:Bind Vm.Model, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="model-v1（原版）"/><ComboBoxItem Content="model-v2（上游新版）"/></ComboBox>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="兩版模型都在本機。儲存後會先提交目前組字，再切換模型；個人詞庫與選字學習會保留。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="Dictionary" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="詞庫與學習" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="預測尚未輸入的後續詞" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="預測尚未輸入的後續詞" IsOn="{x:Bind Vm.Associations, Mode=TwoWay}"/></Grid>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="關閉後只顯示已輸入讀音的候選字。開啟時可在數字或滑鼠選字後提示聯想詞，用 Shift＋數字或滑鼠選取；Enter 提交並關閉候選。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="學習我的選字偏好" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="學習我的選字偏好" IsOn="{x:Bind Vm.Learning, Mode=TwoWay}"/></Grid>
                        <Button Content="清除已儲存的選字學習" Click="ClearLearning" HorizontalAlignment="Left"/>
                        <TextBox Header="個人詞庫" AcceptsReturn="True" MinHeight="160" MaxHeight="300" TextWrapping="Wrap" Text="{x:Bind Vm.DictionaryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="每行填「注音 字詞」，多字注音以 - 分隔。例如：ㄕㄢˋ-ㄐㄧㄝˇ 善解。可在第三欄指定非正數分數，預設 -0.01。儲存後立即載入，並先提交目前組字。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="Keys" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="按鍵" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <ComboBox Header="方向鍵操作" SelectedIndex="{x:Bind Vm.Interaction, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="Windows 微軟注音"/><ComboBoxItem Content="善解上游"/></ComboBox>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="單按 Shift 切換中英" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="單按 Shift 切換中英" IsOn="{x:Bind Vm.ShiftToggle, Mode=TwoWay}"/></Grid>
                        <ComboBox Header="切換用的 Shift 鍵" IsEnabled="{x:Bind Vm.ShiftToggle, Mode=OneWay}" SelectedIndex="{x:Bind Vm.ShiftSide, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="左右 Shift 都可"/><ComboBoxItem Content="僅左 Shift"/><ComboBoxItem Content="僅右 Shift"/></ComboBox>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="Ctrl＋空白切換中英" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="Ctrl＋空白切換中英" IsOn="{x:Bind Vm.CtrlSpaceToggle, Mode=TwoWay}"/></Grid>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="Shift＋空白切換全半形" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="Shift＋空白切換全半形" IsOn="{x:Bind Vm.WidthToggle, Mode=TwoWay}"/></Grid>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="Ctrl＋標點輸入全形標點" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="Ctrl＋標點輸入全形標點" IsOn="{x:Bind Vm.CtrlPunctuation, Mode=TwoWay}"/></Grid>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="反引號＋標點輸入全形標點" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="反引號＋標點輸入全形標點" IsOn="{x:Bind Vm.BackquoteSymbols, Mode=TwoWay}"/></Grid>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="反引號＋U／B 輸入 Unicode／Big5" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="反引號＋U／B 輸入 Unicode／Big5" IsOn="{x:Bind Vm.CodeInput, Mode=TwoWay}"/></Grid>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="鍵盤配置可在一般頁指定，或跟隨 Windows 輸入法清單中的善解標準／倚天 profile。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="Candidates" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="選字" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <ComboBox Header="開啟選字" SelectedIndex="{x:Bind Vm.Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="↓ 下鍵"/><ComboBoxItem Content="空白鍵"/><ComboBoxItem Content="↓ 或空白鍵"/></ComboBox>
                        <ComboBox Header="選字位置" SelectedIndex="{x:Bind Vm.Anchor, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="游標右側的字／詞"/><ComboBoxItem Content="游標左側的字／詞"/></ComboBox>
                        <ComboBox Header="候選排列" SelectedIndex="{x:Bind Vm.Layout, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="直列"/><ComboBoxItem Content="橫列"/><ComboBoxItem Content="格狀"/></ComboBox>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="{x:Bind Vm.CandidateHelp, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="空白鍵換下一頁候選" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="空白鍵換下一頁候選" IsOn="{x:Bind Vm.SpacePages, Mode=TwoWay}"/></Grid>
                        <Grid ColumnSpacing="16" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Microsoft JhengHei UI" Text="候選只顯示 Big5 字元集" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" AutomationProperties.Name="候選只顯示 Big5 字元集" IsOn="{x:Bind Vm.Big5, Mode=TwoWay}" OnContent="Big5" OffContent="Unicode"/></Grid>
                        <NumberBox Header="候選文字大小" Value="{x:Bind Vm.FontSize, Mode=TwoWay}" Minimum="14" Maximum="32" SmallChange="1" SpinButtonPlacementMode="Inline"/>
                        <ComboBox Header="介面主題" SelectedIndex="{x:Bind Vm.Theme, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="跟隨 Windows"/><ComboBoxItem Content="淺色"/><ComboBoxItem Content="深色"/></ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="About" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="善解 Windows" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="WinUI 3 設定與候選介面 · 本機注音引擎" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="所有輸入內容與設定都保留在電腦上。操作 profile 與鍵盤 profile 分開：前者調整操作，後者決定標準／倚天鍵盤。" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="與微軟注音的功能差異" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" x:Name="Differences" TextWrapping="Wrap"/>
                        <HyperlinkButton Content="微軟注音官方操作說明" NavigateUri="https://support.microsoft.com/en-us/windows/hardware/input-devices/microsoft-traditional-chinese-ime" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
        <InfoBar x:Name="StatusBar" Grid.Row="2" Margin="16,4,16,0" IsOpen="False" IsClosable="True" Severity="Success" Message="{x:Bind Vm.Status, Mode=OneWay}"/>
        <Grid Grid.Row="3" Padding="16,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="重新載入已儲存設定" Click="Reload" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"><Button Content="取消" Click="Cancel"/><Button Content="儲存" Style="{ThemeResource AccentButtonStyle}" Click="Save"/></StackPanel>
        </Grid>
    </Grid>
</Window>
