<UserControl x:Class="Shanjie_UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Shanjie_UI.Controls" xmlns:models="using:Shanjie_UI.Models">
    <!-- Settings layout: one sheet of glass, 216 wide navigation on the left with a gliding highlight,
         section title and grouped cards on the right, Shanjie's save bar at the bottom. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="{ThemeResource SjStrokeBrush}" BorderThickness="0,0,1,0" Padding="12,16,12,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="AppTitleBar" Orientation="Horizontal" Spacing="10" Padding="8,0,8,16" Background="Transparent">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" Width="26" Height="26"/>
                    <TextBlock x:Name="TitleText" Text="善解設定" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SjText1Brush}"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Canvas x:Name="NavLayer" IsHitTestVisible="False"/>
                    <StackPanel x:Name="Nav" Spacing="2">
                        <Grid Height="36" Padding="10,0,10,0" Background="Transparent" Tag="general" Tapped="NavTapped" AutomationProperties.Name="一般"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><controls:Icon Glyph="gear" Width="17" Height="17"/><TextBlock Text="一般" FontSize="14" VerticalAlignment="Center"/></StackPanel></Grid>
                        <Grid Height="36" Padding="10,0,10,0" Background="Transparent" Tag="english" Tapped="NavTapped" AutomationProperties.Name="中英混打與切換"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><controls:Icon Glyph="globe" Width="17" Height="17"/><TextBlock Text="中英混打與切換" FontSize="14" VerticalAlignment="Center"/></StackPanel></Grid>
                        <Grid Height="36" Padding="10,0,10,0" Background="Transparent" Tag="keys" Tapped="NavTapped" AutomationProperties.Name="快捷鍵與符號鍵"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><controls:Icon Glyph="keyboard" Width="17" Height="17"/><TextBlock Text="快捷鍵與符號鍵" FontSize="14" VerticalAlignment="Center"/></StackPanel></Grid>
                        <Grid Height="36" Padding="10,0,10,0" Background="Transparent" Tag="punctuation" Tapped="NavTapped" AutomationProperties.Name="標點符號"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><controls:Icon Glyph="case" Width="17" Height="17"/><TextBlock Text="標點符號" FontSize="14" VerticalAlignment="Center"/></StackPanel></Grid>
                        <Grid Height="36" Padding="10,0,10,0" Background="Transparent" Tag="composition" Tapped="NavTapped" AutomationProperties.Name="組字與提交"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><controls:Icon Glyph="pencil" Width="17" Height="17"/><TextBlock Text="組字與提交" FontSize="14" VerticalAlignment="Center"/></StackPanel></Grid>
                        <Grid Height="36" Padding="10,0,10,0" Background="Transparent" Tag="candidates" Tapped="NavTapped" AutomationProperties.Name="選字"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><controls:Icon Glyph="list" Width="17" Height="17"/><TextBlock Text="選字" FontSize="14" VerticalAlignment="Center"/></StackPanel></Grid>
                        <Grid Height="36" Padding="10,0,10,0" Background="Transparent" Tag="appearance" Tapped="NavTapped" AutomationProperties.Name="外觀"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><controls:Icon Glyph="palette" Width="17" Height="17"/><TextBlock Text="外觀" FontSize="14" VerticalAlignment="Center"/></StackPanel></Grid>
                        <Grid Height="36" Padding="10,0,10,0" Background="Transparent" Tag="dictionary" Tapped="NavTapped" AutomationProperties.Name="預測、詞庫與學習"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><controls:Icon Glyph="bookmark" Width="17" Height="17"/><TextBlock Text="預測、詞庫與學習" FontSize="14" VerticalAlignment="Center"/></StackPanel></Grid>
                        <Grid Height="36" Padding="10,0,10,0" Background="Transparent" Tag="about" Tapped="NavTapped" AutomationProperties.Name="關於與相容性"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><controls:Icon Glyph="info" Width="17" Height="17"/><TextBlock Text="關於與相容性" FontSize="14" VerticalAlignment="Center"/></StackPanel></Grid>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="2" Padding="8,12,8,0" TextWrapping="Wrap" LineHeight="19" FontSize="11" Foreground="{ThemeResource SjText3Brush}" Text="{x:Bind Vm.DraftHelp, Mode=OneWay}"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="Head" Padding="24,20,14,12" Background="Transparent">
                <TextBlock x:Name="SectionTitle" Text="一般" Margin="0,0,72,0" Style="{StaticResource SjSectionTitle}"/>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0">
                    <Button Style="{StaticResource SjIconButton}" Click="MinimizeWindow" ToolTipService.ToolTip="最小化" AutomationProperties.Name="最小化"><controls:Icon Glyph="minus" Width="16" Height="16"/></Button>
                    <Button Style="{StaticResource SjIconButton}" Click="CloseWindow" ToolTipService.ToolTip="關閉" AutomationProperties.Name="關閉"><controls:Icon Glyph="close" Width="16" Height="16"/></Button>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="24,0,24,24" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,-12,0,0">
                    <StackPanel x:Name="General">
                        <TextBlock Text="操作預設" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="載入操作預設"><ComboBox x:Name="Preset" SelectionChanged="LoadPreset"/></controls:SettingRow>
                            <controls:SettingRow Stacked="True"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="匯入操作預設…" Click="ImportPreset"/><Button Content="匯出目前操作…" Click="ExportPreset"/></StackPanel></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Style="{StaticResource SjNote}" Text="預設只改按鍵、選字與預測，按儲存後才套用。詞句偏好、模型、詞包、語意校正、模糊輸入、自動空格、詞庫、學習、鍵盤配置與外觀會保留；匯出的檔案也不包含這些內容，可以放心分享。"/>
                        <TextBlock Text="輸入" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="鍵盤配置"><ComboBox x:Name="KeyboardSelector" SelectedIndex="{x:Bind Vm.Keyboard, Mode=TwoWay}"><ComboBoxItem Content="跟隨已安裝的 Windows 配置"/><ComboBoxItem x:Name="StandardKeyboardOption" Content="標準注音" IsEnabled="{x:Bind Vm.StandardInstalled, Mode=OneWay}"/><ComboBoxItem x:Name="EtenKeyboardOption" Content="倚天注音" IsEnabled="{x:Bind Vm.EtenInstalled, Mode=OneWay}"/><ComboBoxItem Content="漢語拼音"/><ComboBoxItem Content="臺灣拼音（通用拼音）"/></ComboBox></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Text="{x:Bind Vm.InstalledKeyboardHelp, Mode=OneWay}" Style="{StaticResource SjNote}"/>
                        <controls:SettingCard>
                            <controls:SettingToggle Label="預設輸入模式" OnText="中文" OffText="英文" IsOn="{x:Bind Vm.InitialChinese, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="預設字元寬度" OnText="全形" OffText="半形" IsOn="{x:Bind Vm.InitialFullWidth, Mode=TwoWay}"/>
                        </controls:SettingCard>
                        <TextBlock Text="語言模型" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="聊天／書面"><controls:Segmented Options="依 App 自動|一律聊天|一律書面" SelectedIndex="{x:Bind Vm.Ranking, Mode=TwoWay}" MinWidth="220"/></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Style="{StaticResource SjNote}" Text="依 App 自動：下面列出的聊天程式（Discord、LINE 等）用聊天設定，其他程式用書面設定。"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="用聊天設定的程式" Stacked="True" IsEnabled="{x:Bind Vm.RankingByApp, Mode=OneWay}"><TextBox IsEnabled="{x:Bind Vm.RankingByApp, Mode=OneWay}" AcceptsReturn="True" MinHeight="80" MaxHeight="160" TextWrapping="Wrap" Text="{x:Bind Vm.ChatApps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Style="{StaticResource SjNote}" Text="每行一個執行檔名稱，例如 discord.exe；可在工作管理員的「詳細資料」查到。瀏覽器裡的網頁聊天無法分辨，跟著瀏覽器用書面設定。"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="模型配置"><ComboBox x:Name="ModelSelector" ItemsSource="{x:Bind Vm.AvailableModels}" DisplayMemberPath="Name" SelectedIndex="{x:Bind Vm.ModelVariant, Mode=OneWay}" SelectionChanged="ModelSelectionChanged"/></controls:SettingRow>
                            <controls:SettingRow Stacked="True"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="取得其他模型…" Click="OnlineModels"/><Button Content="開啟模型資料夾" Click="OpenModelsFolder"/><Button Content="重新掃描" Click="RescanModels"/></StackPanel></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock x:Name="ModelDetails" Style="{StaticResource SjNote}" Text="{x:Bind Vm.ModelHelp, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource SjNote}" Text="線上清單只提供已確認相容的配套；新版本不代表所有情境的準確度都更高。"/>
                    </StackPanel>
                    <StackPanel x:Name="English" Visibility="Collapsed">
                        <TextBlock Text="中英切換" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingToggle Label="單按 Shift 切換中英" IsOn="{x:Bind Vm.ShiftToggle, Mode=TwoWay}"/>
                            <controls:SettingRow Label="切換用的 Shift 鍵" IsEnabled="{x:Bind Vm.ShiftToggle, Mode=OneWay}"><controls:Segmented Options="左右 Shift 都可|僅左 Shift|僅右 Shift" SelectedIndex="{x:Bind Vm.ShiftSide, Mode=TwoWay}" MinWidth="220"/></controls:SettingRow>
                            <controls:SettingToggle Label="Ctrl＋空白切換中英" Description="額外快捷鍵，Windows 預設關閉，保留給 App 的補全等操作。" IsOn="{x:Bind Vm.CtrlSpaceToggle, Mode=TwoWay}"/>
                            <controls:SettingToggle x:Name="CapsLockToggle" Label="Caps Lock 輸入英文" Description="關閉後，Caps Lock 不會讓注音按鍵變成英文。" IsOn="{x:Bind Vm.CapsLockEnglish, Mode=TwoWay}"/>
                        </controls:SettingCard>
                        <TextBlock Text="中英混打" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="中英混打方式" IsEnabled="{x:Bind Vm.IsZhuyin, Mode=OneWay}"><ComboBox x:Name="MixedModeSelector" SelectedIndex="{x:Bind Vm.MixedMode, Mode=TwoWay}"><ComboBoxItem Content="關閉"/><ComboBoxItem Content="{x:Bind Vm.RawKeyMixingLabel}"/><ComboBoxItem Content="上游判斷（僅標準注音）" IsEnabled="{x:Bind Vm.SupportsUpstreamEnglish, Mode=OneWay}"/><ComboBoxItem Content="兩者並用（僅標準注音）" IsEnabled="{x:Bind Vm.SupportsUpstreamEnglish, Mode=OneWay}"/></ComboBox></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Style="{StaticResource SjNote}" Text="{x:Bind Vm.MixedModeNote}"/>
                        <controls:SettingCard>
                            <controls:SettingToggle Label="重打同一個位置算英文" Description="只對上游判斷有效：ok、rust、gta6 這類字要靠它。開了之後，用重打同一個位置來改錯的注音也會變成英文（馬上按 Esc 變回注音）。" IsEnabled="{x:Bind Vm.UsesUpstreamEnglish, Mode=OneWay}" IsOn="{x:Bind Vm.EnglishOverwrite, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="依按鍵順序判斷英文" Description="只對上游判斷有效：打了聲調鍵才發現音節不存在時，整段變成英文（馬上按 Esc 變回注音）；「快打時鍵序顛倒不當英文」關著時，注音鍵沒照順序也會變成英文。" IsEnabled="{x:Bind Vm.UsesUpstreamEnglish, Mode=OneWay}" IsOn="{x:Bind Vm.EnglishKeyOrder, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="快打時鍵序顛倒不當英文" Description="只對上游判斷有效：同一個字的注音鍵先後顛倒（例如 ㄍㄜˋ 打成 ㄜㄍˋ）照注音處理。關掉而且「依按鍵順序判斷英文」開著時，ls、mv 這類字不用按 Shift，但快打容易誤觸。" IsEnabled="{x:Bind Vm.UsesUpstreamEnglish, Mode=OneWay}" IsOn="{x:Bind Vm.EnglishReversalGuard, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="混打相鄰重複鍵容錯" Description="{x:Bind Vm.MixedToleranceHelp}" IsEnabled="{x:Bind Vm.IsZhuyin, Mode=OneWay}" IsOn="{x:Bind Vm.MixedTolerance, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="中英文之間自動加空格" Description="在漢字和半形英文、數字之間自動加一個空格（俗稱「盤古之白」）。只改善解送出的文字，不受中英混打方式影響；開頭會參考游標前一個字。" IsOn="{x:Bind Vm.CjkSpacing, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="無法轉換的注音／拼音序列輸出英數" IsOn="{x:Bind Vm.Alphanumeric, Mode=TwoWay}"/>
                        </controls:SettingCard>
                    </StackPanel>
                    <StackPanel x:Name="Keys" Visibility="Collapsed">
                        <TextBlock Text="全半形切換" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingToggle Label="Shift＋空白切換全半形" IsOn="{x:Bind Vm.WidthToggle, Mode=TwoWay}"/>
                        </controls:SettingCard>
                        <TextBlock Text="符號快捷鍵" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingToggle Label="反白字詞後，快捷鍵加詞" Description="在可編輯欄位選取漢字，於詞旁確認讀音後加入字典。雙 Ctrl 可能與 PowerToys 找滑鼠衝突，可改用替代快捷鍵。" IsOn="{x:Bind Vm.AddWord, Mode=TwoWay}"/>
                            <controls:SettingRow Label="加詞快捷鍵" IsEnabled="{x:Bind Vm.AddWord, Mode=OneWay}"><controls:Segmented Options="連按兩次 Ctrl|Ctrl＋Shift＋F12" SelectedIndex="{x:Bind Vm.AddWordShortcut, Mode=TwoWay}" MinWidth="180"/></controls:SettingRow>
                            <controls:SettingRow Label="雙按使用的 Ctrl 鍵" IsEnabled="{x:Bind Vm.AddWord, Mode=OneWay}"><ComboBox SelectedIndex="{x:Bind Vm.AddWordSide, Mode=TwoWay}"><ComboBoxItem Content="左右均可（兩次須同一側）"/><ComboBoxItem Content="僅左 Ctrl"/><ComboBoxItem Content="僅右 Ctrl"/></ComboBox></controls:SettingRow>
                            <controls:SettingRow Label="雙按間隔（毫秒）" IsEnabled="{x:Bind Vm.AddWord, Mode=OneWay}"><NumberBox Minimum="200" Maximum="1000" SmallChange="50" SpinButtonPlacementMode="Inline" Value="{x:Bind Vm.AddWordInterval, Mode=TwoWay}"/></controls:SettingRow>
                            <controls:SettingToggle Label="Ctrl＋標點輸入全形標點" Description="例如 Ctrl＋逗號輸入 ，；需要 Shift 的符號，仍要一起按 Shift。" IsOn="{x:Bind Vm.CtrlPunctuation, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="Ctrl＋反斜線輸入頓號" Description="善解原有操作；Ctrl 標點開啟時也能輸入頓號。" IsOn="{x:Bind Vm.CtrlBackslash, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="反引號＋標點輸入全形標點" IsOn="{x:Bind Vm.BackquoteSymbols, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="反引號＋U 輸入 Unicode" IsOn="{x:Bind Vm.CodeInput, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="Ctrl＋Alt＋逗號開啟符號鍵盤" IsOn="{x:Bind Vm.SymbolKeyboard, Mode=TwoWay}"/>
                        </controls:SettingCard>
                        <TextBlock Style="{StaticResource SjNote}" Text="Windows 標誌鍵與一般 App 的 Ctrl／Alt 快捷鍵交由系統及 App 處理。"/>
                    </StackPanel>
                    <StackPanel x:Name="Punctuation" Visibility="Collapsed">
                        <TextBlock x:Name="AdvancedKeys" Text="Shift＋符號直接輸入中文標點" Style="{StaticResource SjGroupTitle}"/>
                        <TextBlock Style="{StaticResource SjNote}" Text="善解／Apple 式操作，每個符號可分別開關。關閉的按鍵輸出原本的英文符號。Windows 預設全部關閉。"/>
                        <controls:SettingCard>
                            <controls:SettingRow Stacked="True"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="全部開啟" Click="ShiftAllOn"/><Button Content="全部關閉" Click="ShiftAllOff"/></StackPanel></controls:SettingRow>
                            <controls:SettingRow Stacked="True"><ItemsControl ItemsSource="{x:Bind Vm.ShiftKeys}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="150"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:PunctuationKey"><CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsOn, Mode=TwoWay}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Text="直接按鍵輸入中文標點" Style="{StaticResource SjGroupTitle}"/>
                        <TextBlock Style="{StaticResource SjNote}" Text="不按 Ctrl，直接按鍵輸入標點；每個按鍵分別設定，例如只開「」而不讓 \ 變成頓號。注音鍵（如倚天的 ' 與 =）不受影響。"/>
                        <controls:SettingCard>
                            <controls:SettingRow Stacked="True"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="全部開啟" Click="PlainAllOn"/><Button Content="全部關閉" Click="PlainAllOff"/></StackPanel></controls:SettingRow>
                            <controls:SettingRow Stacked="True"><ItemsControl ItemsSource="{x:Bind Vm.PlainKeys}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="150"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:PunctuationKey"><CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsOn, Mode=TwoWay}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></controls:SettingRow>
                        </controls:SettingCard>
                    </StackPanel>
                    <StackPanel x:Name="Composition" Visibility="Collapsed">
                        <controls:SettingCard>
                            <controls:SettingToggle x:Name="ReadingPanelToggle" Label="組字面板" Description="{x:Bind Vm.ReadingPanelHelp, Mode=OneWay}" IsEnabled="{x:Bind Vm.CanChooseReadingPanel, Mode=OneWay}" IsOn="{x:Bind Vm.ReadingPanelShown, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="沒有組字時，聲調鍵輸入聲調符號" Description="善解特有操作：例如標準鍵盤 3 輸入 ˇ，留在組字區，Enter 才提交。關閉時輸入原本的數字。" IsOn="{x:Bind Vm.StandaloneTones, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="標點保留未完成的注音" Description="關閉時與上游相同：讀音還沒打完就按標點，未完成的注音會丟掉，標點直接進組字。開啟時注音留著，標點排在後面，補完聲調才一起轉換。" IsEnabled="{x:Bind Vm.IsZhuyin, Mode=OneWay}" IsOn="{x:Bind Vm.PunctuationKeepsReading, Mode=TwoWay}"/>
                        </controls:SettingCard>
                        <TextBlock Text="Esc" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="未開候選時的 Esc"><ComboBox SelectedIndex="{x:Bind Vm.Escape, Mode=TwoWay}"><ComboBoxItem Content="先清未完成的讀音，再清整句"/><ComboBoxItem Content="一次清除全部未提交組字"/><ComboBoxItem Content="保留組字"/></ComboBox></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Style="{StaticResource SjNote}" Text="候選或已進入的預測列仍先關閉／退出，不會因這個選項立即刪除整句。"/>
                        <TextBlock Text="Enter" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingToggle x:Name="EnterToCursorToggle" Label="Enter 只提交游標前的字" Description="游標在組字中間時，Enter 只送出游標前（選字後含所選的字）的部分，後面的字繼續留在組字區可再選字。關閉時一律送出整句。" IsOn="{x:Bind Vm.EnterToCursor, Mode=TwoWay}"/>
                        </controls:SettingCard>
                        <TextBlock Text="空白鍵" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingToggle x:Name="SpaceInputsZhuyinToggle" Label="空白鍵輸入注音符號" Description="開啟沿用注音符號輸入。關閉時，無法轉換的按鍵照原樣輸出，例如 1＋空白得到數字 1 和空格；第一聲仍可轉換。字詞候選第一項提供注音。" IsEnabled="{x:Bind Vm.IsZhuyin, Mode=OneWay}" IsOn="{x:Bind Vm.SpaceInputsZhuyin, Mode=TwoWay}"/>
                            <controls:SettingToggle x:Name="SpaceCommitsToggle" Label="空白鍵提交組字" Description="預設關閉：直接在組字中插入空格，仍可繼續編輯。注音第一聲與拼音轉換依原有規則處理。" IsOn="{x:Bind Vm.SpaceCommits, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="提交後再補一個空格" Description="只在空白鍵用來提交組字時生效。" IsEnabled="{x:Bind Vm.SpaceCommits, Mode=OneWay}" IsOn="{x:Bind Vm.SpaceAfterCommit, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="拼音按一次空白就轉換" Description="關閉時，第一次空白分隔音節，Enter 或連按兩次空白轉換。聲調鍵 1–5 皆可直接轉換。" IsOn="{x:Bind Vm.PinyinSpaceConverts, Mode=TwoWay}"/>
                        </controls:SettingCard>
                    </StackPanel>
                    <StackPanel x:Name="Candidates" Visibility="Collapsed">
                        <TextBlock Text="選字操作" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="方向鍵操作"><controls:Segmented Options="Windows／微軟注音 ↑↓|善解上游 ←→" SelectedIndex="{x:Bind Vm.Interaction, Mode=TwoWay}" MinWidth="180"/></controls:SettingRow>
                            <controls:SettingRow Label="選字位置"><controls:Segmented Options="游標右側的字／詞|游標左側的字／詞" SelectedIndex="{x:Bind Vm.Anchor, Mode=TwoWay}" MinWidth="180"/></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Style="{StaticResource SjNote}" Text="{x:Bind Vm.CandidateHelp, Mode=OneWay}"/>
                        <controls:SettingCard>
                            <controls:SettingToggle x:Name="CandidateKeyOptions" Label="候選中 Enter 選字並提交整句" Description="關閉時只確認候選，繼續留在組字區。" IsOn="{x:Bind Vm.EnterCommits, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="未開候選時，↑ 直接換下一個候選" IsOn="{x:Bind Vm.UpCycles, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="候選中 Backspace 同時刪除前一個字" Description="關閉時只收回候選，保留組字。" IsOn="{x:Bind Vm.BackspaceDeletes, Mode=TwoWay}"/>
                        </controls:SettingCard>
                        <TextBlock Text="翻頁" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="{x:Bind Vm.RightActionLabel, Mode=OneWay}" Description="無：維持原方向鍵操作；下一頁：翻頁；展開：三欄多列，數字選字以反白所在的九項為一組，↑／↓ 逐項移動，頂列 ↑ 收回。Windows 操作預設的 Tab 跟 → 同一個動作，並預設展開，與微軟注音相同；善解操作預設的 Tab 與上游相同，關閉候選並交給 App。">
                                <ComboBox x:Name="CandidateRightAction" SelectedIndex="{x:Bind Vm.RightAction, Mode=TwoWay}" MinWidth="140"><ComboBoxItem Content="無"/><ComboBoxItem Content="下一頁"/><ComboBoxItem Content="展開"/></ComboBox>
                            </controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Text="空白鍵操作候選" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingToggle x:Name="SpaceOperatesToggle" Label="空白鍵操作候選字" Description="關閉時用 ↓ 開啟選字，空白不開啟或翻動候選（Windows 範本的預設）。開啟後依下方設定操作（善解範本的預設，與上游相同）；候選操作優先於空白提交。" IsOn="{x:Bind Vm.SpaceOperates, Mode=TwoWay}"/>
                            <controls:SettingRow Label="完整組字後開啟選字" IsEnabled="{x:Bind Vm.SpaceOperates, Mode=OneWay}"><controls:Segmented Options="↓ 下鍵|空白鍵|↓ 或空白鍵" SelectedIndex="{x:Bind Vm.Trigger, Mode=TwoWay}" MinWidth="220"/></controls:SettingRow>
                            <controls:SettingToggle Label="空白換下一頁候選" IsEnabled="{x:Bind Vm.SpaceOperates, Mode=OneWay}" IsOn="{x:Bind Vm.SpacePages, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="最後一頁再換頁時回到第一頁" Description="適用於空白鍵與設為「下一頁」的右方向鍵。" IsEnabled="{x:Bind Vm.CanWrapSpacePages, Mode=OneWay}" IsOn="{x:Bind Vm.WrapPages, Mode=TwoWay}"/>
                        </controls:SettingCard>
                    </StackPanel>
                    <StackPanel x:Name="Appearance" Visibility="Collapsed">
                        <TextBlock x:Name="AppearanceOptions" Text="候選視窗" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="候選排列"><controls:Segmented Options="橫向（善解膠囊列）|直式（微軟注音）" SelectedIndex="{x:Bind Vm.CandidateLayout, Mode=TwoWay}" MinWidth="180"/></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Style="{StaticResource SjNote}" Text="每頁最多九項；直式一列一個候選，與微軟注音相同。"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="候選文字大小"><NumberBox Value="{x:Bind Vm.FontSize, Mode=TwoWay}" Minimum="14" Maximum="32" SmallChange="1" SpinButtonPlacementMode="Inline"/></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Text="主題與提示" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="介面與選字框主題"><controls:Segmented Options="跟隨 Windows|淺色|深色" SelectedIndex="{x:Bind Vm.Theme, Mode=TwoWay}" MinWidth="220"/></controls:SettingRow>
                            <controls:SettingToggle Label="切換中英時顯示游標旁提示" IsOn="{x:Bind Vm.ModeIndicator, Mode=TwoWay}"/>
                            <controls:SettingRow Label="玻璃濃度" Description="越高越不透，背後的桌布越淡；套用到設定、安裝程式與選字框。Windows 關閉透明效果時改用不透明背景。"><controls:RangeSlider x:Name="GlassTintSlider" Minimum="0" Maximum="100" Step="1" Value="{x:Bind Vm.GlassTint, Mode=TwoWay}"/></controls:SettingRow>
                        </controls:SettingCard>
                    </StackPanel>
                    <StackPanel x:Name="Dictionary" Visibility="Collapsed">
                        <controls:SettingCard>
                            <controls:SettingToggle x:Name="PredictionToggle" Label="未完成讀音的即時預測" Description="第一個注音鍵就提示可能的完整詞。Tab 進入，數字／Enter 選詞；Shift＋Tab 或 Esc 退出。Windows 預設關閉。" IsOn="{x:Bind Vm.Prediction, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="選字後的聯想詞" Description="數字或滑鼠選字後提示尚未輸入的後續詞，以 Shift＋數字或滑鼠選取。Windows 預設關閉。" IsOn="{x:Bind Vm.Associations, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="使用游標前文改善選字" Description="只使用游標前的少量文字作為本機選字與學習的前文，不傳送到網路。" IsOn="{x:Bind Vm.UseContext, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="避免敏感詞排在第一名" Description="套用上游的特定詞降權表；詞仍可選取，並非刪除詞庫。" IsOn="{x:Bind Vm.Demote, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="語意校正" Description="組字時用小型語意模型再檢查整句，把不通順的選字換成更合理的寫法。需要開啟上一項；變更會重新載入核心。" IsEnabled="{x:Bind Vm.Demote, Mode=OneWay}" IsOn="{x:Bind Vm.Rerank, Mode=TwoWay}"/>
                            <controls:SettingRow Label="語意校正強度" IsEnabled="{x:Bind Vm.RerankLevelEnabled, Mode=OneWay}"><controls:Segmented Options="保守|標準|積極" SelectedIndex="{x:Bind Vm.RerankLevel, Mode=TwoWay}" MinWidth="220"/></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Text="詞包" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingToggle Label="動漫與遊戲詞" Description="約四萬五千個作品名與角色名，來自中文維基百科（CC BY-SA 4.0）。關閉後選字結果與沒有詞包時相同；變更會重新載入核心。" IsOn="{x:Bind Vm.AcgPack, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="經典台詞" Description="經典電影台詞，與上游相同，預設關閉；變更會重新載入核心。" IsOn="{x:Bind Vm.QuotePack, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="資訊與 AI 詞" Description="約一千個程式、軟體與 AI 相關的詞，與上游相同；變更會重新載入核心。" IsOn="{x:Bind Vm.ItPack, Mode=TwoWay}"/>
                        </controls:SettingCard>
                        <TextBlock Text="模糊輸入" Style="{StaticResource SjGroupTitle}"/>
                        <TextBlock Style="{StaticResource SjNote}" Text="勾選的注音互相通用，例如開啟 ㄣ／ㄥ 後打 ㄅㄣ 也找得到 ㄅㄥ 的詞。預設全部關閉；變更會重新載入核心。"/>
                        <controls:SettingCard>
                            <controls:SettingToggle Label="ㄣ／ㄥ" IsOn="{x:Bind Vm.FuzzyEnEng, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="ㄓ／ㄗ" IsOn="{x:Bind Vm.FuzzyZhZ, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="ㄔ／ㄘ" IsOn="{x:Bind Vm.FuzzyChC, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="ㄕ／ㄙ" IsOn="{x:Bind Vm.FuzzyShS, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="鄰鍵打錯" Description="打出詞庫沒有的讀音時，改用鍵盤上左右相鄰的鍵來猜；只適用標準注音鍵盤。" IsEnabled="{x:Bind Vm.SupportsFuzzyAdjacent, Mode=OneWay}" IsOn="{x:Bind Vm.FuzzyAdjacent, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="學習我的選字偏好" IsOn="{x:Bind Vm.Learning, Mode=TwoWay}"/>
                            <controls:SettingToggle Label="Ctrl＋Shift＋Backspace 忘記目前候選的學習" Description="學習開啟且有反白候選時生效；不刪除個人詞庫。" IsEnabled="{x:Bind Vm.Learning, Mode=OneWay}" IsOn="{x:Bind Vm.ForgetCandidate, Mode=TwoWay}"/>
                            <controls:SettingRow Stacked="True"><Button Content="清除已儲存的選字學習" Click="ClearLearning"/></controls:SettingRow>
                            <controls:SettingRow Label="個人詞庫" Stacked="True"><TextBox x:Name="PersonalDictionaryEditor" AcceptsReturn="True" MinHeight="160" MaxHeight="300" TextWrapping="Wrap" Text="{x:Bind Vm.DictionaryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock Style="{StaticResource SjNote}" Text="每行填「注音 字詞」，例如：ㄕㄢˋ-ㄐㄧㄝˇ 善解。可在第三欄指定非正數分數，預設 -0.01。儲存後先提交組字再載入。"/>
                    </StackPanel>
                    <StackPanel x:Name="About" Visibility="Collapsed">
                        <TextBlock Text="善解輸入法" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard Padding="14,12,14,12" Spacing="6">
                            <TextBlock Text="原生 Windows 候選 · 本機注音引擎" FontSize="14" Foreground="{ThemeResource SjText1Brush}" TextWrapping="Wrap"/>
                            <TextBlock Text="輸入內容、詞庫、學習及設定都留在電腦上。操作預設調整按鍵與候選；鍵盤配置決定標準／倚天或拼音。" Style="{StaticResource SjBody}"/>
                        </controls:SettingCard>
                        <TextBlock Text="與微軟注音的差異" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard Padding="14,12,14,12" Spacing="4">
                            <TextBlock x:Name="Differences" Style="{StaticResource SjBody}"/>
                            <HyperlinkButton Content="微軟注音官方操作說明" NavigateUri="https://support.microsoft.com/en-us/windows/hardware/input-devices/microsoft-traditional-chinese-ime" Padding="0,4,0,0"/>
                            <HyperlinkButton Content="上游模型與詞類表說明" NavigateUri="https://github.com/Nanako0129/shanjie/blob/main/data/models.tsv" Padding="0"/>
                        </controls:SettingCard>
                        <TextBlock Text="更新" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow x:Name="UpdateRow" Label="善解 Windows 版"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="UpdateDetails" Content="查看說明" Visibility="Collapsed" Click="OpenRelease"/><Button x:Name="UpdateSwitch" Visibility="Collapsed" Click="SwitchUpdate"/><Button x:Name="UpdateButton" Content="檢查更新" Click="UpdateAction"/></StackPanel></controls:SettingRow>
                            <controls:SettingToggle x:Name="AutoUpdateToggle" Label="自動檢查更新" Description="登入時與之後每天向 GitHub 查一次，有新版時在螢幕右下角通知，不會自動下載。輸入內容不會傳送。"/>
                            <controls:SettingRow Label="更新通道" Description="測試版是尚在試用的版本，可能不穩定。切換後會重新檢查。"><controls:Segmented x:Name="UpdateChannelChoice" Options="正式版|測試版" MinWidth="160"/></controls:SettingRow>
                        </controls:SettingCard>
                        <TextBlock x:Name="UpdateNotes" Style="{StaticResource SjNote}" Visibility="Collapsed" MaxLines="8" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="解除安裝" Style="{StaticResource SjGroupTitle}"/>
                        <controls:SettingCard>
                            <controls:SettingRow Label="解除安裝善解" Description="移除輸入法、設定程式與登入啟動排程，可選擇保留個人詞庫與選字學習。也可以從 Windows 的「已安裝的應用程式」移除。"><Button Content="解除安裝…" Click="Uninstall"/></controls:SettingRow>
                        </controls:SettingCard>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <InfoBar x:Name="StatusBar" Grid.Row="2" Margin="24,0,24,8" CornerRadius="12" IsOpen="False" IsClosable="True" Severity="Success" Message="{x:Bind Vm.Status, Mode=OneWay}"/>
            <Grid Grid.Row="3" Padding="24,12,24,16" BorderBrush="{ThemeResource SjStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="重新載入已儲存設定" Click="Reload" MinHeight="32"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button Content="重新啟動輸入法" Click="Restart" MinHeight="32" ToolTipService.ToolTip="儲存設定、提交目前組字並重載善解核心"/><Button Content="取消" Click="Cancel" MinHeight="32"/><Button Content="儲存" Style="{StaticResource SjAccentButton}" Click="Save" MinHeight="32"/></StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
