<Window x:Class="Shanjie_UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Shanjie_UI.Controls" xmlns:models="using:Shanjie_UI.Models" Title="善解設定">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <Style x:Key="HelpText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft JhengHei UI"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="善解設定" />
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="208" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="Navigate">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="一般" Icon="Home" Tag="general"/>
                <NavigationViewItem Content="切換與快捷鍵" Icon="Keyboard" Tag="keys"/>
                <NavigationViewItem Content="標點符號" Icon="Font" Tag="punctuation"/>
                <NavigationViewItem Content="組字與提交" Icon="Edit" Tag="composition"/>
                <NavigationViewItem Content="選字" Icon="Bullets" Tag="candidates"/>
                <NavigationViewItem Content="外觀" Icon="View" Tag="appearance"/>
                <NavigationViewItem Content="預測、詞庫與學習" Icon="Library" Tag="dictionary"/>
                <NavigationViewItem Content="關於與相容性" Icon="Help" Tag="about"/>
            </NavigationView.MenuItems>
            <ScrollViewer x:Name="ContentScroll">
                <StackPanel Padding="20,16,20,20" Spacing="12" MaxWidth="800" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="General" Spacing="12">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="一般" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="操作預設" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <ComboBox Header="載入操作預設" x:Name="Preset" HorizontalAlignment="Stretch" SelectionChanged="LoadPreset"/>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="匯入操作預設…" Click="ImportPreset"/><Button Content="匯出目前操作…" Click="ExportPreset"/></StackPanel>
                        <TextBlock Style="{StaticResource HelpText}" Text="預設只改按鍵、選字與預測，按儲存後才套用。詞句偏好、詞庫、學習、鍵盤配置與外觀會保留；匯出的檔案也不包含這些內容，可以放心分享。"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="輸入" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
                        <ComboBox x:Name="KeyboardSelector" Header="鍵盤配置" SelectedIndex="{x:Bind Vm.Keyboard, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="跟隨已安裝的 Windows 配置"/><ComboBoxItem x:Name="StandardKeyboardOption" Content="標準注音" IsEnabled="{x:Bind Vm.StandardInstalled, Mode=OneWay}"/><ComboBoxItem x:Name="EtenKeyboardOption" Content="倚天注音" IsEnabled="{x:Bind Vm.EtenInstalled, Mode=OneWay}"/><ComboBoxItem Content="漢語拼音"/><ComboBoxItem Content="臺灣拼音（通用拼音）"/></ComboBox>
                        <TextBlock Text="{x:Bind Vm.InstalledKeyboardHelp, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <controls:SettingToggle Label="預設輸入模式" OnText="中文" OffText="英文" IsOn="{x:Bind Vm.InitialChinese, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="預設字元寬度" OnText="全形" OffText="半形" IsOn="{x:Bind Vm.InitialFullWidth, Mode=TwoWay}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="語言模型" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
                        <ComboBox Header="詞句偏好" SelectedIndex="{x:Bind Vm.Ranking, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="聊天"/><ComboBoxItem Content="正式"/></ComboBox>
                        <TextBlock x:Name="ModelSelector" Text="語言模型：model-v5＋classes-v3" FontFamily="Microsoft JhengHei UI"/>
                        <TextBlock x:Name="ModelDetails" Style="{StaticResource HelpText}" Text="{x:Bind Vm.ModelHelp, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource HelpText}" Text="只提供最新模型與固定配對詞類表。個人詞庫與選字學習會保留，模型在本機執行。"/>
                    </StackPanel>
                    <StackPanel x:Name="Keys" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="切換與快捷鍵" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="中英與全半形切換" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <controls:SettingToggle Label="單按 Shift 切換中英" IsOn="{x:Bind Vm.ShiftToggle, Mode=TwoWay}"/>
                        <ComboBox Header="切換用的 Shift 鍵" IsEnabled="{x:Bind Vm.ShiftToggle, Mode=OneWay}" SelectedIndex="{x:Bind Vm.ShiftSide, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="左右 Shift 都可"/><ComboBoxItem Content="僅左 Shift"/><ComboBoxItem Content="僅右 Shift"/></ComboBox>
                        <controls:SettingToggle Label="Ctrl＋空白切換中英" Description="額外快捷鍵，Windows 預設關閉，保留給 App 的補全等操作。" IsOn="{x:Bind Vm.CtrlSpaceToggle, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="Shift＋空白切換全半形" IsOn="{x:Bind Vm.WidthToggle, Mode=TwoWay}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="符號快捷鍵" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
                        <controls:SettingToggle Label="Ctrl＋標點輸入全形標點" Description="例如 Ctrl＋逗號輸入 ，；需要 Shift 的符號，仍要一起按 Shift。" IsOn="{x:Bind Vm.CtrlPunctuation, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="Ctrl＋反斜線輸入頓號" Description="善解原有操作；Ctrl 標點開啟時也能輸入頓號。" IsOn="{x:Bind Vm.CtrlBackslash, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="反引號＋標點輸入全形標點" IsOn="{x:Bind Vm.BackquoteSymbols, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="反引號＋U／B 輸入 Unicode／Big5" IsOn="{x:Bind Vm.CodeInput, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="Ctrl＋Alt＋逗號開啟符號鍵盤" IsOn="{x:Bind Vm.SymbolKeyboard, Mode=TwoWay}"/>
                        <TextBlock Style="{StaticResource HelpText}" Text="Windows 標誌鍵與一般 App 的 Ctrl／Alt 快捷鍵交由系統及 App 處理。"/>
                    </StackPanel>
                    <StackPanel x:Name="Punctuation" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="標點符號" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock x:Name="AdvancedKeys" FontFamily="Microsoft JhengHei UI" Text="Shift＋符號直接輸入中文標點" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Style="{StaticResource HelpText}" Text="善解／Apple 式操作，每個符號可分別開關。關閉的按鍵輸出原本的英文符號。Windows 預設全部關閉。"/>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="全部開啟" Click="ShiftAllOn"/><Button Content="全部關閉" Click="ShiftAllOff"/></StackPanel>
                        <ItemsControl ItemsSource="{x:Bind Vm.ShiftKeys}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="150"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:PunctuationKey"><CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" FontFamily="Microsoft JhengHei UI"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="直接按鍵輸入中文標點" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource HelpText}" Text="不按 Ctrl，直接按鍵輸入標點；每個按鍵分別設定，例如只開「」而不讓 \ 變成頓號。注音鍵（如倚天的 ' 與 =）不受影響。"/>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="全部開啟" Click="PlainAllOn"/><Button Content="全部關閉" Click="PlainAllOff"/></StackPanel>
                        <ItemsControl ItemsSource="{x:Bind Vm.PlainKeys}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="150"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:PunctuationKey"><CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" FontFamily="Microsoft JhengHei UI"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="Composition" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="組字與提交" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="中英混打與英數" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <controls:SettingToggle x:Name="MixedInputToggle" Label="中英混打自動判斷" Description="組字區先顯示英文按鍵，下方提示注音；輸入聲調後轉成中文，Enter 保留英文。適用標準／倚天注音。" IsEnabled="{x:Bind Vm.IsZhuyin, Mode=OneWay}" IsOn="{x:Bind Vm.MixedInput, Mode=TwoWay}"/>
                        <controls:SettingToggle x:Name="CapsLockToggle" Label="Caps Lock 輸入英文" Description="關閉後，Caps Lock 不會讓注音按鍵變成英文。" IsOn="{x:Bind Vm.CapsLockEnglish, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="無法轉換的注音／拼音序列輸出英數" IsOn="{x:Bind Vm.Alphanumeric, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="沒有組字時，聲調鍵輸入聲調符號" Description="善解特有操作：例如標準鍵盤 3 輸入 ˇ，留在組字區，Enter 才提交。關閉時輸入原本的數字。" IsOn="{x:Bind Vm.StandaloneTones, Mode=TwoWay}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="Esc" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
                        <ComboBox Header="未開候選時的 Esc" SelectedIndex="{x:Bind Vm.Escape, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="先清未完成的讀音，再清整句"/><ComboBoxItem Content="一次清除全部未提交組字"/><ComboBoxItem Content="保留組字"/></ComboBox>
                        <TextBlock Style="{StaticResource HelpText}" Text="候選或已進入的預測列仍先關閉／退出，不會因這個選項立即刪除整句。"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="空白鍵" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
                        <controls:SettingToggle x:Name="SpaceInputsZhuyinToggle" Label="空白鍵輸入注音符號" Description="開啟沿用注音符號輸入。關閉時，無法轉換的按鍵照原樣輸出，例如 1＋空白得到數字 1 和空格；第一聲仍可轉換。字詞候選第一項提供注音。" IsEnabled="{x:Bind Vm.IsZhuyin, Mode=OneWay}" IsOn="{x:Bind Vm.SpaceInputsZhuyin, Mode=TwoWay}"/>
                        <controls:SettingToggle x:Name="SpaceCommitsToggle" Label="空白鍵提交組字" Description="預設關閉：直接在組字中插入空格，仍可繼續編輯。注音第一聲與拼音轉換依原有規則處理。" IsOn="{x:Bind Vm.SpaceCommits, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="提交後再補一個空格" Description="只在空白鍵用來提交組字時生效。" IsEnabled="{x:Bind Vm.SpaceCommits, Mode=OneWay}" IsOn="{x:Bind Vm.SpaceAfterCommit, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="拼音按一次空白就轉換" Description="關閉時，第一次空白分隔音節，Enter 或連按兩次空白轉換。聲調鍵 1–5 皆可直接轉換。" IsOn="{x:Bind Vm.PinyinSpaceConverts, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel x:Name="Candidates" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="選字" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="選字操作" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <ComboBox Header="方向鍵操作" SelectedIndex="{x:Bind Vm.Interaction, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="Windows／微軟注音 ↑↓"/><ComboBoxItem Content="善解上游 ←→"/></ComboBox>
                        <ComboBox Header="選字位置" SelectedIndex="{x:Bind Vm.Anchor, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="游標右側的字／詞"/><ComboBoxItem Content="游標左側的字／詞"/></ComboBox>
                        <TextBlock Style="{StaticResource HelpText}" Text="{x:Bind Vm.CandidateHelp, Mode=OneWay}"/>
                        <controls:SettingToggle x:Name="CandidateKeyOptions" Label="候選中 Enter 選字並提交整句" Description="關閉時只確認候選，繼續留在組字區。" IsOn="{x:Bind Vm.EnterCommits, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="未開候選時，↑ 直接換下一個候選" IsOn="{x:Bind Vm.UpCycles, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="候選中 Backspace 同時刪除前一個字" Description="關閉時只收回候選，保留組字。" IsOn="{x:Bind Vm.BackspaceDeletes, Mode=TwoWay}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="空白鍵操作候選" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
                        <controls:SettingToggle x:Name="SpaceOperatesToggle" Label="空白鍵操作候選字" Description="預設關閉：用 ↓ 開啟選字，空白不開啟或翻動候選。開啟後依下方設定操作；候選操作優先於空白提交。" IsOn="{x:Bind Vm.SpaceOperates, Mode=TwoWay}"/>
                        <ComboBox Header="完整組字後開啟選字" IsEnabled="{x:Bind Vm.SpaceOperates, Mode=OneWay}" SelectedIndex="{x:Bind Vm.Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="↓ 下鍵"/><ComboBoxItem Content="空白鍵"/><ComboBoxItem Content="↓ 或空白鍵"/></ComboBox>
                        <controls:SettingToggle Label="空白換下一頁候選" IsEnabled="{x:Bind Vm.SpaceOperates, Mode=OneWay}" IsOn="{x:Bind Vm.SpacePages, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="最後一頁再按空白回到第一頁" IsEnabled="{x:Bind Vm.CanWrapSpacePages, Mode=OneWay}" IsOn="{x:Bind Vm.WrapPages, Mode=TwoWay}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="字元集" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
                        <controls:SettingToggle Label="候選只顯示 Big5 字元集" Description="同時套用到轉換候選、即時預測與聯想詞；已組好的文字不會被轉換。" IsOn="{x:Bind Vm.Big5, Mode=TwoWay}" OnText="Big5" OffText="Unicode"/>
                    </StackPanel>
                    <StackPanel x:Name="Appearance" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="外觀" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock x:Name="AppearanceOptions" FontFamily="Microsoft JhengHei UI" Text="候選視窗" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <ComboBox Header="候選排列" SelectedIndex="{x:Bind Vm.CandidateLayout, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="橫向（善解膠囊列）"/><ComboBoxItem Content="直式（微軟注音）"/></ComboBox>
                        <TextBlock Style="{StaticResource HelpText}" Text="每頁最多九項；直式一列一個候選，與微軟注音相同。"/>
                        <NumberBox Header="候選文字大小" Value="{x:Bind Vm.FontSize, Mode=TwoWay}" Minimum="14" Maximum="32" SmallChange="1" SpinButtonPlacementMode="Inline"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="主題與提示" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
                        <ComboBox Header="介面與選字框主題" SelectedIndex="{x:Bind Vm.Theme, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="跟隨 Windows"/><ComboBoxItem Content="淺色"/><ComboBoxItem Content="深色"/></ComboBox>
                        <controls:SettingToggle Label="切換中英時顯示游標旁提示" IsOn="{x:Bind Vm.ModeIndicator, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel x:Name="Dictionary" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="預測、詞庫與學習" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <controls:SettingToggle x:Name="PredictionToggle" Label="未完成讀音的即時預測" Description="第一個注音鍵就提示可能的完整詞。Tab 進入，數字／Enter 選詞；Shift＋Tab 或 Esc 退出。Windows 預設關閉。" IsOn="{x:Bind Vm.Prediction, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="選字後的聯想詞" Description="數字或滑鼠選字後提示尚未輸入的後續詞，以 Shift＋數字或滑鼠選取。Windows 預設關閉。" IsOn="{x:Bind Vm.Associations, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="使用游標前文改善選字" Description="只使用游標前的少量文字作為本機選字與學習的前文，不傳送到網路。" IsOn="{x:Bind Vm.UseContext, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="避免敏感詞排在第一名" Description="套用上游的特定詞降權表；詞仍可選取，並非刪除詞庫。" IsOn="{x:Bind Vm.Demote, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="學習我的選字偏好" IsOn="{x:Bind Vm.Learning, Mode=TwoWay}"/>
                        <controls:SettingToggle Label="Ctrl＋Shift＋Backspace 忘記目前候選的學習" Description="學習開啟且有反白候選時生效；不刪除個人詞庫。" IsEnabled="{x:Bind Vm.Learning, Mode=OneWay}" IsOn="{x:Bind Vm.ForgetCandidate, Mode=TwoWay}"/>
                        <Button Content="清除已儲存的選字學習" Click="ClearLearning" HorizontalAlignment="Left"/>
                        <TextBox x:Name="PersonalDictionaryEditor" Header="個人詞庫" AcceptsReturn="True" MinHeight="160" MaxHeight="300" TextWrapping="Wrap" Text="{x:Bind Vm.DictionaryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource HelpText}" Text="每行填「注音 字詞」，例如：ㄕㄢˋ-ㄐㄧㄝˇ 善解。可在第三欄指定非正數分數，預設 -0.01。儲存後先提交組字再載入。"/>
                    </StackPanel>
                    <StackPanel x:Name="About" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="善解 Windows" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="WinUI 3 設定 · 原生 Windows 候選 · 本機注音引擎" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="輸入內容、詞庫、學習及設定都留在電腦上。操作預設調整按鍵與候選；鍵盤配置決定標準／倚天或拼音。" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" Text="與微軟注音的差異" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock FontFamily="Microsoft JhengHei UI" x:Name="Differences" TextWrapping="Wrap"/>
                        <HyperlinkButton Content="微軟注音官方操作說明" NavigateUri="https://support.microsoft.com/en-us/windows/hardware/input-devices/microsoft-traditional-chinese-ime" HorizontalAlignment="Left"/>
                        <HyperlinkButton Content="上游 model-v5 與詞類表說明" NavigateUri="https://github.com/Nanako0129/shanjie/releases/tag/model-v5" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
        <InfoBar x:Name="StatusBar" Grid.Row="2" Margin="16,4,16,0" IsOpen="False" IsClosable="True" Severity="Success" Message="{x:Bind Vm.Status, Mode=OneWay}"/>
        <Grid Grid.Row="3" Padding="16,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="重新載入已儲存設定" Click="Reload"/><TextBlock Text="{x:Bind Vm.DraftHelp, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"><Button Content="重新啟動輸入法" Click="Restart" ToolTipService.ToolTip="儲存設定、提交目前組字並重載善解核心"/><Button Content="取消" Click="Cancel"/><Button Content="儲存" Style="{ThemeResource AccentButtonStyle}" Click="Save"/></StackPanel>
        </Grid>
    </Grid>
</Window>
