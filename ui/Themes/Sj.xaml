<?xml version="1.0" encoding="utf-8"?>
<!--
  Design tokens and control styles for Shanjie's glass windows: text, stroke and fill colors per theme,
  radii (panel 20, item 12, control 10), control heights (24 / 28 / 32 / 40) and the accent (霧藍).
  The font is Noto Sans when installed, otherwise the system default (GlassWindow.Font).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Shanjie_UI.Controls" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SjText1Color">#EB141418</Color>
            <Color x:Key="SjText2Color">#C7141418</Color>
            <Color x:Key="SjText3Color">#9E141418</Color>
            <Color x:Key="SjStrokeColor">#14000000</Color>
            <Color x:Key="SjFillHoverColor">#0B000000</Color>
            <Color x:Key="SjFillSelectedColor">#9EFFFFFF</Color>
            <Color x:Key="SjFillControlColor">#80FFFFFF</Color>
            <SolidColorBrush x:Key="SjText1Brush" Color="{ThemeResource SjText1Color}"/>
            <SolidColorBrush x:Key="SjText2Brush" Color="{ThemeResource SjText2Color}"/>
            <SolidColorBrush x:Key="SjText3Brush" Color="{ThemeResource SjText3Color}"/>
            <SolidColorBrush x:Key="SjStrokeBrush" Color="{ThemeResource SjStrokeColor}"/>
            <SolidColorBrush x:Key="SjFillHoverBrush" Color="{ThemeResource SjFillHoverColor}"/>
            <SolidColorBrush x:Key="SjFillSelectedBrush" Color="{ThemeResource SjFillSelectedColor}"/>
            <SolidColorBrush x:Key="SjFillControlBrush" Color="{ThemeResource SjFillControlColor}"/>
            <!-- Status bar per severity: icon color, a faint wash over the card glass, and a thin tinted edge -->
            <SolidColorBrush x:Key="SjStatusInfoBrush" Color="#FF5874C9"/>
            <SolidColorBrush x:Key="SjStatusSuccessBrush" Color="#FF27894E"/>
            <SolidColorBrush x:Key="SjStatusWarningBrush" Color="#FFB86E00"/>
            <SolidColorBrush x:Key="SjStatusErrorBrush" Color="#FFD63D43"/>
            <SolidColorBrush x:Key="SjStatusInfoTintBrush" Color="#145874C9"/>
            <SolidColorBrush x:Key="SjStatusSuccessTintBrush" Color="#142F9E5B"/>
            <SolidColorBrush x:Key="SjStatusWarningTintBrush" Color="#1AF5A524"/>
            <SolidColorBrush x:Key="SjStatusErrorTintBrush" Color="#14E5484D"/>
            <SolidColorBrush x:Key="SjStatusInfoStrokeBrush" Color="#385874C9"/>
            <SolidColorBrush x:Key="SjStatusSuccessStrokeBrush" Color="#382F9E5B"/>
            <SolidColorBrush x:Key="SjStatusWarningStrokeBrush" Color="#47F5A524"/>
            <SolidColorBrush x:Key="SjStatusErrorStrokeBrush" Color="#38E5484D"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SjText1Color">#F0FFFFFF</Color>
            <Color x:Key="SjText2Color">#A3FFFFFF</Color>
            <Color x:Key="SjText3Color">#73FFFFFF</Color>
            <Color x:Key="SjStrokeColor">#14FFFFFF</Color>
            <Color x:Key="SjFillHoverColor">#0FFFFFFF</Color>
            <Color x:Key="SjFillSelectedColor">#1FFFFFFF</Color>
            <Color x:Key="SjFillControlColor">#12FFFFFF</Color>
            <SolidColorBrush x:Key="SjText1Brush" Color="{ThemeResource SjText1Color}"/>
            <SolidColorBrush x:Key="SjText2Brush" Color="{ThemeResource SjText2Color}"/>
            <SolidColorBrush x:Key="SjText3Brush" Color="{ThemeResource SjText3Color}"/>
            <SolidColorBrush x:Key="SjStrokeBrush" Color="{ThemeResource SjStrokeColor}"/>
            <SolidColorBrush x:Key="SjFillHoverBrush" Color="{ThemeResource SjFillHoverColor}"/>
            <SolidColorBrush x:Key="SjFillSelectedBrush" Color="{ThemeResource SjFillSelectedColor}"/>
            <SolidColorBrush x:Key="SjFillControlBrush" Color="{ThemeResource SjFillControlColor}"/>
            <SolidColorBrush x:Key="SjStatusInfoBrush" Color="#FF8DA2E3"/>
            <SolidColorBrush x:Key="SjStatusSuccessBrush" Color="#FF5CC489"/>
            <SolidColorBrush x:Key="SjStatusWarningBrush" Color="#FFF5B544"/>
            <SolidColorBrush x:Key="SjStatusErrorBrush" Color="#FFF07479"/>
            <SolidColorBrush x:Key="SjStatusInfoTintBrush" Color="#1C5874C9"/>
            <SolidColorBrush x:Key="SjStatusSuccessTintBrush" Color="#1C2F9E5B"/>
            <SolidColorBrush x:Key="SjStatusWarningTintBrush" Color="#1CF5A524"/>
            <SolidColorBrush x:Key="SjStatusErrorTintBrush" Color="#1CE5484D"/>
            <SolidColorBrush x:Key="SjStatusInfoStrokeBrush" Color="#4D7F96DB"/>
            <SolidColorBrush x:Key="SjStatusSuccessStrokeBrush" Color="#4D4CB87A"/>
            <SolidColorBrush x:Key="SjStatusWarningStrokeBrush" Color="#4DF5B544"/>
            <SolidColorBrush x:Key="SjStatusErrorStrokeBrush" Color="#4DF07479"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="SjAccentColor">#FF5874C9</Color>
    <SolidColorBrush x:Key="SjAccentBrush" Color="{StaticResource SjAccentColor}"/>
    <Color x:Key="SjDangerColor">#FFE5484D</Color>
    <SolidColorBrush x:Key="SjDangerBrush" Color="{StaticResource SjDangerColor}"/>
    <SolidColorBrush x:Key="SjSuccessBrush" Color="#FF2F9E5B"/>
    <SolidColorBrush x:Key="SjWarningBrush" Color="#FFF5A524"/>
    <CornerRadius x:Key="SjRadiusItem">12</CornerRadius>
    <CornerRadius x:Key="SjRadiusControl">10</CornerRadius>

    <!-- WinUI controls (text boxes, drop-downs, number boxes, check and radio buttons) in the theme colors:
         neutral control fill with a thin stroke, 10 px corners, the accent only for state and focus. -->
    <StaticResource x:Key="TextControlBackground" ResourceKey="SjFillControlBrush"/>
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SjFillControlBrush"/>
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SjFillSelectedBrush"/>
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SjStrokeBrush"/>
    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SjStrokeBrush"/>
    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SjAccentBrush"/>
    <StaticResource x:Key="TextControlForeground" ResourceKey="SjText1Brush"/>
    <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="SjText1Brush"/>
    <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="SjText1Brush"/>
    <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="SjText3Brush"/>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <StaticResource x:Key="ComboBoxBackground" ResourceKey="SjFillControlBrush"/>
    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SjFillSelectedBrush"/>
    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SjFillSelectedBrush"/>
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="SjStrokeBrush"/>
    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="SjStrokeBrush"/>
    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="SjStrokeBrush"/>
    <StaticResource x:Key="ComboBoxForeground" ResourceKey="SjText1Brush"/>
    <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="SjText2Brush"/>
    <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="SjAccentBrush"/>
    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="SjAccentBrush"/>
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="SjAccentBrush"/>
    <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="SjFillControlBrush"/>
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="SjStrokeBrush"/>
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="SjAccentBrush"/>
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="SjAccentBrush"/>
    <StaticResource x:Key="RadioButtonOuterEllipseFill" ResourceKey="SjFillControlBrush"/>
    <StaticResource x:Key="RadioButtonOuterEllipseStroke" ResourceKey="SjStrokeBrush"/>
    <StaticResource x:Key="ProgressBarForeground" ResourceKey="SjAccentBrush"/>
    <StaticResource x:Key="ProgressRingForegroundThemeBrush" ResourceKey="SjAccentBrush"/>
    <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="SjAccentBrush"/>
    <StaticResource x:Key="ScrollBarThumbFill" ResourceKey="SjText3Brush"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="220"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Noto Sans TC's taller line box drops the label below the 20px circle with the stock 6px top padding -->
    <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
        <Setter Property="Padding" Value="8,2,0,0"/>
    </Style>
    <Style TargetType="NumberBox">
        <Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="140"/>
    </Style>

    <Style x:Key="SjFlyoutPresenter" TargetType="FlyoutPresenter">
        <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/>
        <Setter Property="IsDefaultShadowEnabled" Value="False"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{ThemeResource SjStrokeBrush}"/>
        <Setter Property="MaxWidth" Value="Infinity"/>
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Group title above a card; note text under it -->
    <Style x:Key="SjGroupTitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,20,0,8"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource SjText2Brush}"/>
    </Style>
    <Style x:Key="SjNote" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,6,2,0"/><Setter Property="FontSize" Value="11"/><Setter Property="LineHeight" Value="18"/>
        <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{ThemeResource SjText3Brush}"/>
    </Style>
    <Style x:Key="SjSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{ThemeResource SjText1Brush}"/>
    </Style>
    <Style x:Key="SjBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="19"/><Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{ThemeResource SjText2Brush}"/>
    </Style>

    <!-- Icon button: transparent, neutral fill on hover -->
    <Style x:Key="SjIconButton" TargetType="Button">
        <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{ThemeResource SjText2Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Bg.Background" Value="{ThemeResource SjFillHoverBrush}"/><Setter Target="Content.Foreground" Value="{ThemeResource SjText1Brush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Bg.Background" Value="{ThemeResource SjFillHoverBrush}"/><Setter Target="Content.Foreground" Value="{ThemeResource SjText1Brush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Bg.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text button: neutral fill and thin stroke, darker on hover; the implicit style for every Button -->
    <Style x:Key="SjTextButton" TargetType="Button">
        <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="12,0,12,0"/><Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource SjText1Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Bg" Background="{ThemeResource SjFillControlBrush}" BorderBrush="{ThemeResource SjStrokeBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border x:Name="Hover" Background="{ThemeResource SjFillHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                        <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SjTextButton}"/>

    <!-- Accent button for the one main action in a footer (settings 儲存): same size as a text button, accent fill -->
    <Style x:Key="SjAccentButton" TargetType="Button" BasedOn="{StaticResource SjTextButton}">
        <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Background="{StaticResource SjAccentBrush}" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border x:Name="Hover" Background="#1FFFFFFF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                        <Border x:Name="Press" Background="#1A000000" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                        <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Press.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary button for the installer's single main action: same size as a text button, accent fill, white semibold text -->
    <Style x:Key="SjPrimaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="12,0,12,0"/><Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource SjAccentBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/><Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border x:Name="Hover" Background="#1FFFFFFF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                        <Border x:Name="Press" Background="#1A000000" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                        <Border x:Name="Ring" Margin="-3" BorderBrush="{TemplateBinding Background}" BorderThickness="2" CornerRadius="13" Opacity="0"/>
                        <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Press.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Bg.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused"/>
                                <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="Ring.Opacity" Value="0.55"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status bar (InfoBar) on the card glass: 12 px corners, a faint severity wash and tinted 1 px edge, a Lucide
         severity icon (check / info / triangle / x, so severity reads without color), Noto text and an icon close button.
         It rises and fades in, and fades out (StatusMotion). High contrast swaps to system colors inside the bar only. -->
    <Style TargetType="InfoBar">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="AutomationProperties.LandmarkType" Value="Custom"/>
        <Setter Property="AutomationProperties.IsDialog" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="InfoBar">
                    <Border x:Name="ContentRoot" VerticalAlignment="Top" controls:StatusMotion.IsAnimated="True" Background="{ThemeResource SjFillControlBrush}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush x:Key="SjFillControlBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                                        <SolidColorBrush x:Key="SjText1Brush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                                        <SolidColorBrush x:Key="SjText2Brush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                                        <SolidColorBrush x:Key="SjStatusInfoBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                                        <SolidColorBrush x:Key="SjStatusSuccessBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                                        <SolidColorBrush x:Key="SjStatusWarningBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                                        <SolidColorBrush x:Key="SjStatusErrorBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                                        <SolidColorBrush x:Key="SjStatusInfoTintBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="SjStatusSuccessTintBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="SjStatusWarningTintBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="SjStatusErrorTintBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="SjStatusInfoStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                                        <SolidColorBrush x:Key="SjStatusSuccessStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                                        <SolidColorBrush x:Key="SjStatusWarningStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                                        <SolidColorBrush x:Key="SjStatusErrorStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Border.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SeverityLevels">
                                <VisualState x:Name="Informational"/>
                                <VisualState x:Name="Error"><VisualState.Setters>
                                    <Setter Target="Wash.Background" Value="{ThemeResource SjStatusErrorTintBrush}"/><Setter Target="Wash.BorderBrush" Value="{ThemeResource SjStatusErrorStrokeBrush}"/>
                                    <Setter Target="StandardIcon.Glyph" Value="circle-x"/><Setter Target="StandardIcon.Foreground" Value="{ThemeResource SjStatusErrorBrush}"/>
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="Warning"><VisualState.Setters>
                                    <Setter Target="Wash.Background" Value="{ThemeResource SjStatusWarningTintBrush}"/><Setter Target="Wash.BorderBrush" Value="{ThemeResource SjStatusWarningStrokeBrush}"/>
                                    <Setter Target="StandardIcon.Glyph" Value="warn"/><Setter Target="StandardIcon.Foreground" Value="{ThemeResource SjStatusWarningBrush}"/>
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="Success"><VisualState.Setters>
                                    <Setter Target="Wash.Background" Value="{ThemeResource SjStatusSuccessTintBrush}"/><Setter Target="Wash.BorderBrush" Value="{ThemeResource SjStatusSuccessStrokeBrush}"/>
                                    <Setter Target="StandardIcon.Glyph" Value="circle-check"/><Setter Target="StandardIcon.Foreground" Value="{ThemeResource SjStatusSuccessBrush}"/>
                                </VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="IconStates">
                                <VisualState x:Name="StandardIconVisible"/>
                                <VisualState x:Name="UserIconVisible"><VisualState.Setters><Setter Target="UserIconBox.Visibility" Value="Visible"/><Setter Target="StandardIcon.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="NoIconVisible"><VisualState.Setters><Setter Target="StandardIcon.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup>
                                <VisualState x:Name="CloseButtonVisible"/>
                                <VisualState x:Name="CloseButtonCollapsed"><VisualState.Setters><Setter Target="CloseButton.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="InfoBarVisibility">
                                <VisualState x:Name="InfoBarVisible"/>
                                <VisualState x:Name="InfoBarCollapsed"><VisualState.Setters><Setter Target="ContentRoot.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup>
                                <VisualState x:Name="ForegroundNotSet"/>
                                <VisualState x:Name="ForegroundSet"><VisualState.Setters>
                                    <Setter Target="Title.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>
                                    <Setter Target="Message.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>
                                </VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup>
                                <VisualState x:Name="BannerContent"/>
                                <VisualState x:Name="NoBannerContent"><VisualState.Setters><Setter Target="ContentArea.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Wash" Background="{ThemeResource SjStatusInfoTintBrush}" BorderBrush="{ThemeResource SjStatusInfoStrokeBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid MinHeight="44" Padding="14,8,8,8" ColumnSpacing="10" Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <controls:Icon x:Name="StandardIcon" Glyph="info" Width="18" Height="18" VerticalAlignment="Center" Foreground="{ThemeResource SjStatusInfoBrush}" AutomationProperties.AccessibilityView="Raw"/>
                                <Viewbox x:Name="UserIconBox" Visibility="Collapsed" Width="18" Height="18" VerticalAlignment="Center" Child="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IconElement}"/>
                                <primitives:InfoBarPanel Grid.Column="1" VerticalAlignment="Center" HorizontalOrientationPadding="0" VerticalOrientationPadding="0">
                                    <TextBlock x:Name="Title" Text="{TemplateBinding Title}" Foreground="{ThemeResource SjText1Brush}" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" TextWrapping="WrapWholeWords" primitives:InfoBarPanel.HorizontalOrientationMargin="0,0,10,0" primitives:InfoBarPanel.VerticalOrientationMargin="0,0,0,2"/>
                                    <TextBlock x:Name="Message" Text="{TemplateBinding Message}" Foreground="{ThemeResource SjText1Brush}" FontSize="{TemplateBinding FontSize}" LineHeight="20" TextWrapping="WrapWholeWords"/>
                                    <ContentPresenter Content="{TemplateBinding ActionButton}" VerticalAlignment="Center" primitives:InfoBarPanel.HorizontalOrientationMargin="12,0,0,0" primitives:InfoBarPanel.VerticalOrientationMargin="0,8,0,0"/>
                                </primitives:InfoBarPanel>
                                <ContentPresenter x:Name="ContentArea" Grid.Column="1" Grid.Row="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                <Button x:Name="CloseButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SjIconButton}" Foreground="{ThemeResource SjText2Brush}" Command="{TemplateBinding CloseButtonCommand}" CommandParameter="{TemplateBinding CloseButtonCommandParameter}">
                                    <controls:Icon Glyph="close" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
