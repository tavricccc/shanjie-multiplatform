<UserControl x:Class="Shanjie_UI.Controls.SettingToggle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SettingControl">
    <Grid ColumnSpacing="16" MinHeight="40">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock FontFamily="Microsoft JhengHei UI" Text="{Binding Label, ElementName=SettingControl}" TextWrapping="Wrap"/>
            <TextBlock x:Name="DescriptionText" FontFamily="Microsoft JhengHei UI" FontSize="13" Text="{Binding Description, ElementName=SettingControl}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
        </StackPanel>
        <ToggleSwitch x:Name="Toggle" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label, ElementName=SettingControl}"
            IsOn="{Binding IsOn, ElementName=SettingControl, Mode=TwoWay}"
            OnContent="{Binding OnText, ElementName=SettingControl}" OffContent="{Binding OffText, ElementName=SettingControl}"/>
    </Grid>
</UserControl>
