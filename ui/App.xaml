<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Shanjie_UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shanjie_UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft JhengHei UI</FontFamily>
            <!-- Minimize and close on the glass title bar; the frameless glass window has no system caption buttons. -->
            <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="10"/>
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/><Setter Property="FontSize" Value="10"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
