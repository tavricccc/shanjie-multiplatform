<UserControl x:Class="Shanjie_UI.QuickSetupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Shanjie_UI.Controls">
    <!-- Quick Setup inside the settings window's glass: a head with the progress, one step at a time in the middle
         (built in code, one question per screen) and skip / back / continue at the bottom. -->
    <Grid x:Name="Root" Background="Transparent" KeyDown="RootKeyDown">
        <Grid.Resources>
            <!-- An answer card: the glass card of the settings pages, a touch of hover; the chosen outline and check are drawn by ChoiceCards. -->
            <Style x:Key="QuickChoice" TargetType="RadioButton">
                <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="56"/>
                <Setter Property="CornerRadius" Value="14"/><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="FocusVisualMargin" Value="-3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root">
                                <Border Background="{ThemeResource SjFillControlBrush}" BorderBrush="{ThemeResource SjStrokeBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}"/>
                                <Border x:Name="Hover" Background="{ThemeResource SjFillHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                                <ContentPresenter x:Name="Presenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="16,12,16,12"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Opacity" Value="0.55"/></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked"/>
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Indeterminate"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Skip: text only until hovered, so the way forward stays the one strong button. -->
            <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource SjTextButton}">
                <Setter Property="Foreground" Value="{ThemeResource SjText2Brush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root">
                                <Border x:Name="Hover" Background="{ThemeResource SjFillHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                                <ContentPresenter x:Name="Presenter" Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/><Setter Target="Presenter.Foreground" Value="{ThemeResource SjText1Brush}"/></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/><Setter Target="Presenter.Foreground" Value="{ThemeResource SjText1Brush}"/></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="CaptionArea" Height="52" Padding="20,0,14,0" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" Width="22" Height="22"/>
                <TextBlock Text="快速設定" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SjText1Brush}"/>
            </StackPanel>
            <StackPanel x:Name="ProgressArea" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <controls:StepProgress x:Name="Progress"/>
                <TextBlock x:Name="StepText" FontSize="12" MinWidth="30" VerticalAlignment="Center" Foreground="{ThemeResource SjText3Brush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SjIconButton}" Click="MinimizeWindow" ToolTipService.ToolTip="最小化" AutomationProperties.Name="最小化"><controls:Icon Glyph="minus" Width="16" Height="16" Foreground="{ThemeResource SjText2Brush}"/></Button>
                <Button Style="{StaticResource SjIconButton}" Click="CloseWindow" ToolTipService.ToolTip="關閉" AutomationProperties.Name="關閉"><controls:Icon Glyph="close" Width="16" Height="16" Foreground="{ThemeResource SjText2Brush}"/></Button>
            </StackPanel>
        </Grid>
        <Grid x:Name="Pages" Grid.Row="1"/>
        <Grid x:Name="Footer" Grid.Row="2" Padding="36,10,36,22" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Style="{StaticResource QuietButton}" MinHeight="36" FontSize="13" Click="Skip"/>
            <TextBlock x:Name="ErrorText" Grid.Column="1" Margin="8,0,8,0" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource SjDangerBrush}" Visibility="Collapsed"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button x:Name="BackButton" Content="上一步" MinHeight="36" MinWidth="84" FontSize="13" Click="Back" ToolTipService.ToolTip="上一步（Esc）"/>
                <Button x:Name="NextButton" MinHeight="36" MinWidth="112" FontSize="13" Style="{StaticResource SjAccentButton}" Click="Next"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
