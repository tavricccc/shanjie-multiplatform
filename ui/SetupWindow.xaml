<Window x:Class="Shanjie_UI.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:setup="using:Shanjie_UI.Setup" Title="善解輸入法">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <Style x:Key="HelpText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="善解輸入法" />
        <ScrollViewer Grid.Row="1" Padding="32,16,32,24">
            <Grid>
                <StackPanel x:Name="WelcomePage" Spacing="12">
                    <TextBlock x:Name="WelcomeTitle" Text="安裝善解輸入法" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WelcomeText" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource HelpText}" Text="善解是本機注音輸入法：輸入內容、詞庫與學習都留在這台電腦。安裝時 Windows 會要求系統管理員權限，用來註冊輸入法並設定登入時啟動核心。"/>
                    <TextBlock x:Name="WelcomeTarget" Style="{StaticResource HelpText}" IsTextSelectionEnabled="True"/>
                    <InfoBar x:Name="StatusError" Severity="Error" IsClosable="False" Title="無法讀取目前的安裝狀態"/>
                </StackPanel>
                <StackPanel x:Name="KeyboardPage" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="選擇鍵盤配置" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock x:Name="KeyboardSummary" TextWrapping="Wrap"/>
                    <RadioButtons x:Name="KeyboardChoice" SelectedIndex="0">
                        <RadioButton><StackPanel><TextBlock Text="標準注音"/><TextBlock Style="{StaticResource HelpText}" Text="大千式排列，一般注音鍵盤"/></StackPanel></RadioButton>
                        <RadioButton><StackPanel><TextBlock Text="倚天注音"/><TextBlock Style="{StaticResource HelpText}" Text="倚天式排列"/></StackPanel></RadioButton>
                    </RadioButtons>
                    <TextBlock Style="{StaticResource HelpText}" Text="只安裝選定的配置。個人詞庫、選字學習與輸入偏好都會保留，之後重新執行安裝程式即可更換。"/>
                </StackPanel>
                <StackPanel x:Name="UninstallPage" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="UninstallTitle" Text="解除安裝善解輸入法" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
                    <TextBlock TextWrapping="Wrap" Text="會移除輸入法註冊、登入時啟動核心的排程，並刪除全部程式檔案；仍被開啟中程式使用的檔案會在重新登入或重新開機後自動刪除。Windows 會要求系統管理員權限。"/>
                    <RadioButtons x:Name="DataChoice" Header="個人資料" SelectedIndex="0">
                        <RadioButton><StackPanel><TextBlock Text="保留個人詞庫與選字學習"/><TextBlock Style="{StaticResource HelpText}" Text="只移除設定，重新安裝後詞庫和學習可以繼續使用。"/></StackPanel></RadioButton>
                        <RadioButton><StackPanel><TextBlock Text="一併移除個人詞庫、學習與設定"/><TextBlock Style="{StaticResource HelpText}" Text="個人詞庫、選字學習與設定會直接刪除，無法復原。"/></StackPanel></RadioButton>
                    </RadioButtons>
                </StackPanel>
                <StackPanel x:Name="ProgressPage" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressTitle" Text="正在安裝" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource HelpText}" Text="請在 Windows 的權限視窗中按「是」。"/>
                    <ProgressBar x:Name="Progress" IsIndeterminate="True"/>
                    <ItemsControl x:Name="Steps" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="setup:SetupStep">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3" Opacity="{x:Bind Opacity, Mode=OneWay}">
                                    <Grid Width="16" Height="16">
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" Visibility="{x:Bind ShowsGlyph, Mode=OneWay}"/>
                                        <ProgressRing IsActive="{x:Bind IsRunning, Mode=OneWay}" Width="16" Height="16" MinWidth="0" MinHeight="0"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Label, Mode=OneTime}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel x:Name="DonePage" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="DoneTitle" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
                    <InfoBar x:Name="DoneBar" IsOpen="True" IsClosable="False"/>
                    <TextBlock x:Name="DoneText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="2" Padding="32,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button x:Name="BackButton" Content="上一步" Click="Back" Visibility="Collapsed"/>
                <Button x:Name="SecondaryButton" Content="取消" Click="Secondary"/>
                <Button x:Name="PrimaryButton" Content="下一步" Style="{ThemeResource AccentButtonStyle}" Click="Primary"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
