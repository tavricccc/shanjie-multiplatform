<UserControl x:Class="Shanjie_UI.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:setup="using:Shanjie_UI.Setup" xmlns:controls="using:Shanjie_UI.Controls">
    <!-- Setup window: close/minimize head, centred logo, title and tagline, option card, centred capsule action. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource SjNote}"><Setter Property="TextWrapping" Value="Wrap"/></Style>
            <Style x:Key="SetupTitle" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{ThemeResource SjText1Brush}"/></Style>
            <Style x:Key="SetupBody" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{ThemeResource SjText2Brush}"/></Style>
            <Style x:Key="OptionCard" TargetType="Border"><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Background" Value="{ThemeResource SjFillControlBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource SjStrokeBrush}"/></Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Height="48" Padding="20,0,8,0" Background="Transparent"><TextBlock x:Name="TitleText" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource SjIconButton}" Click="MinimizeWindow" ToolTipService.ToolTip="最小化" AutomationProperties.Name="最小化"><controls:Icon Glyph="minus" Width="16" Height="16"/></Button><Button Style="{StaticResource SjIconButton}" Click="CloseWindow" ToolTipService.ToolTip="關閉" AutomationProperties.Name="關閉"><controls:Icon Glyph="close" Width="16" Height="16"/></Button></StackPanel></Grid>
        <ScrollViewer Grid.Row="1" Padding="40,0,40,16">
            <Grid>
                <StackPanel x:Name="WelcomePage" Spacing="10">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" Width="72" Height="72" Margin="0,8,0,6"/>
                    <TextBlock x:Name="WelcomeTitle" Text="安裝善解輸入法" Style="{StaticResource SetupTitle}"/>
                    <TextBlock x:Name="WelcomeText" Style="{StaticResource SetupBody}"/>
                    <TextBlock Style="{StaticResource HelpText}" TextAlignment="Center" Margin="0,6,0,0" Text="善解是本機注音輸入法：輸入內容、詞庫與學習都留在這台電腦。安裝時 Windows 會要求系統管理員權限，用來註冊輸入法並設定登入時啟動核心。"/>
                    <TextBlock x:Name="WelcomeTarget" Style="{StaticResource HelpText}" TextAlignment="Center" IsTextSelectionEnabled="True"/>
                    <InfoBar x:Name="StatusError" Severity="Error" IsClosable="False" Title="無法讀取目前的安裝狀態"/>
                </StackPanel>
                <StackPanel x:Name="KeyboardPage" Spacing="10" Visibility="Collapsed">
                    <controls:Icon Glyph="keyboard" Width="40" Height="40" Margin="0,8,0,6" Foreground="{ThemeResource SjText1Brush}"/>
                    <TextBlock Text="選擇鍵盤配置" Style="{StaticResource SetupTitle}"/>
                    <TextBlock x:Name="KeyboardSummary" Style="{StaticResource SetupBody}"/>
                    <Border Style="{StaticResource OptionCard}" Margin="0,6,0,0">
                        <RadioButtons x:Name="KeyboardChoice" SelectedIndex="0" AutomationProperties.Name="鍵盤配置">
                            <RadioButton><StackPanel><TextBlock Text="標準注音"/><TextBlock Style="{StaticResource HelpText}" Text="大千式排列，一般注音鍵盤"/></StackPanel></RadioButton>
                            <RadioButton><StackPanel><TextBlock Text="倚天注音"/><TextBlock Style="{StaticResource HelpText}" Text="倚天式排列"/></StackPanel></RadioButton>
                        </RadioButtons>
                    </Border>
                    <TextBlock Style="{StaticResource HelpText}" Text="只安裝選定的配置。個人詞庫、選字學習與輸入偏好都會保留，之後重新執行安裝程式即可更換。"/>
                </StackPanel>
                <StackPanel x:Name="UninstallPage" Spacing="10" Visibility="Collapsed">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" Width="72" Height="72" Margin="0,8,0,6"/>
                    <TextBlock x:Name="UninstallTitle" Text="解除安裝善解輸入法" Style="{StaticResource SetupTitle}"/>
                    <TextBlock Style="{StaticResource SetupBody}" Text="會移除輸入法註冊、登入時啟動核心的排程，並刪除全部程式檔案；仍被開啟中程式使用的檔案會在重新登入或重新開機後自動刪除。Windows 會要求系統管理員權限。"/>
                    <TextBlock Style="{StaticResource SjGroupTitle}" Text="個人資料" Margin="0,8,0,0"/>
                    <Border Style="{StaticResource OptionCard}">
                        <RadioButtons x:Name="DataChoice" SelectedIndex="0" AutomationProperties.Name="個人資料">
                            <RadioButton><StackPanel><TextBlock Text="保留個人詞庫與選字學習"/><TextBlock Style="{StaticResource HelpText}" Text="只移除設定，重新安裝後詞庫和學習可以繼續使用。"/></StackPanel></RadioButton>
                            <RadioButton><StackPanel><TextBlock Text="一併移除個人詞庫、學習與設定"/><TextBlock Style="{StaticResource HelpText}" Text="個人詞庫、選字學習與設定會直接刪除，無法復原。"/></StackPanel></RadioButton>
                        </RadioButtons>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="ProgressPage" Spacing="10" Visibility="Collapsed">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" Width="56" Height="56" Margin="0,8,0,6"/>
                    <TextBlock x:Name="ProgressTitle" Text="正在安裝" Style="{StaticResource SetupTitle}" FontSize="20"/>
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="6" MinHeight="6" CornerRadius="3" Margin="24,6" Background="{ThemeResource SjFillControlBrush}"/>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource SetupBody}" Text="請在 Windows 的權限視窗中按「是」。"/>
                    <Border Style="{StaticResource OptionCard}" Margin="0,8,0,0">
                        <ItemsControl x:Name="Steps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="setup:SetupStep">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3" Opacity="{x:Bind Opacity, Mode=OneWay}">
                                        <Grid Width="16" Height="16">
                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" Visibility="{x:Bind ShowsGlyph, Mode=OneWay}"/>
                                            <ProgressRing IsActive="{x:Bind IsRunning, Mode=OneWay}" Width="16" Height="16" MinWidth="0" MinHeight="0"/>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Label, Mode=OneTime}" FontSize="13"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="DonePage" Spacing="10" Visibility="Collapsed">
                    <Grid Width="64" Height="64" Margin="0,8,0,6">
                        <Border x:Name="DoneCircle" CornerRadius="32" Background="{ThemeResource SjAccentBrush}"/>
                        <controls:Icon x:Name="DoneIcon" Glyph="check" Width="30" Height="30" Foreground="White"/>
                    </Grid>
                    <TextBlock x:Name="DoneTitle" Style="{StaticResource SetupTitle}"/>
                    <TextBlock x:Name="DoneSummary" Style="{StaticResource SetupBody}"/>
                    <TextBlock x:Name="DoneHint" Style="{StaticResource HelpText}" TextAlignment="Center"/>
                    <TextBlock x:Name="DoneText" Style="{StaticResource HelpText}" TextAlignment="Center" IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Padding="40,8,40,28">
            <Button x:Name="BackButton" Content="上一步" Style="{StaticResource SjTextButton}" Click="Back" Visibility="Collapsed"/>
            <Button x:Name="SecondaryButton" Content="取消" Style="{StaticResource SjTextButton}" Click="Secondary"/>
            <Button x:Name="PrimaryButton" Content="下一步" Style="{StaticResource SjPrimaryButton}" Click="Primary"/>
        </StackPanel>
    </Grid>
</UserControl>
